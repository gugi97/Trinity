# Build output
build/
out/
*.asi
*.pdb
*.exp
*.ilk

# Visual Studio / CMake local state
.vs/
*.user
CMakeSettings.json
CMakeUserPresets.json
compile_commands.json

# RC compiler temporaries (RCxxxxx / RCaxxxxx left next to the .rc)
src/RC[0-9a-zA-Z]*

# Local tooling config (machine-specific, may contain tokens)
.claude/
.mcp.json

# Reverse-engineering scratch work
/scripts/Frida/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Working notes and one-off reverse-engineering scripts. Kept locally, not
# published: they are addresses, dead ends and half-proven leads, not something
# anyone downloading the mod needs. tools/shaders/ stays - it is real source.
docs/
tools/vtweak/
tools/analyze_item_ctor.py
tools/disasm_pe.py

# Agent and skill-framework state. Machine-local working directories, and they
# accumulate notes that belong in the same box as docs/ - not in a public repo.
.superpowers/
.planning/
.gsd/
.serena/
.aider*
.cursor/
.windsurf/

# Session transcripts dumped into the repo root by the CLI tools.
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# Runtime and debugging output. Trinity.log is written next to the installed
# .asi, but it lands here whenever the mod is run from the build tree, and it
# carries whatever the last session was tracing.
*.log
*.dmp
*.etl
*.rpt

# Leftovers from editing, patching, and interrupted merges.
*.bak
*.orig
*.rej
*.tmp
*~
~$*

# Release staging. pack-release.ps1 builds these; the finished zip belongs on
# Nexus, not in git.
/stage/
/release/
Trinity-*.zip

# Test and analysis caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Editors and OS.
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
desktop.ini
.DS_Store
